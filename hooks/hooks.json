{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "sessionstart",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-sessionstart.mjs"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "UserPromptSubmit"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "PostToolUse"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "PostToolUseFailure"
            ],
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "AskUserQuestion"
            ],
            "timeout": 720
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "PermissionRequest"
            ],
            "timeout": 720
          }
        ]
      }
    ],
    "Elicitation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "Elicitation"
            ],
            "timeout": 720
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "Notification"
            ],
            "timeout": 3,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "Stop"
            ],
            "timeout": 5
          },
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "watch",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-watch.mjs"
            ],
            "asyncRewake": true,
            "rewakeMessage": "[FLEETDECK] Fleet board mail for you:",
            "rewakeSummary": "Fleet Deck: board mail delivered",
            "timeout": 86430
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "SessionEnd"
            ],
            "timeout": 1,
            "async": true
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/hook-launcher.sh",
              "decision",
              "${CLAUDE_PLUGIN_ROOT}/scripts/fleet-hook.mjs",
              "CwdChanged"
            ],
            "timeout": 3,
            "async": true
          }
        ]
      }
    ]
  }
}
