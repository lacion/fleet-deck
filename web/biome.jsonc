{
  // Lint and format for the v2 board. A nested config of the repository root
  // config: `root: false` keeps the v0 `biome lint` at the root working.
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.css",
      "!**/node_modules",
      "!dist",
      // Generated by ts-rs (`make ts-types`); the drift test owns them.
      "!src/gen"
    ]
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  }
}
