{
  "$schema": "./web/node_modules/@biomejs/biome/configuration_schema.json",
  // Root Biome config. Since the v0 cutover (M3 7-7, DL-132) the only
  // TypeScript code is the v2 board in web/, whose web/biome.jsonc extends
  // this file ("extends": "//") and sets its own file scope.
  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": false },

  "files": {
    "includes": ["web/**/*.ts", "web/**/*.tsx", "!**/node_modules", "!web/dist"]
  },

  // ── Formatter: mirrors .prettierrc.json exactly (commit B does the sweep) ─────
  // singleQuote:true semi:true tabWidth:2 useTabs:false printWidth:100
  // trailingComma:"all" arrowParens:"always". jsxSingleQuote was unset in Prettier
  // (→ double), matched by jsxQuoteStyle:"double".
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "quoteProperties": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },

  // ── Linter ──────────────────────────────────────────────────────────────────
  // Sensible recommended baseline. Step 1 is a TOOL SWAP, not a lint-tightening:
  // every rule turned OFF below is a Biome-recommended rule that flags code the
  // old ESLint (js.recommended + typescript-eslint strict/stylistic, NO react /
  // a11y / react-hooks plugins) accepted. Disabling preserves parity without
  // touching source; re-tightening is a later, deliberate step.
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        // No jsx-a11y plugin existed under ESLint — the whole a11y set is new.
        "noAutofocus": "off",
        "noStaticElementInteractions": "off",
        "noSvgWithoutTitle": "off",
        "useAriaPropsSupportedByRole": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off"
      },
      "complexity": {
        // Stylistic suggestions ESLint did not enforce.
        "noCommaOperator": "off", // sequence exprs in existing terse code
        // DIRECT CONFLICT with tsconfig noPropertyAccessFromIndexSignature (which
        // REQUIRES a['b'] for index signatures); the TS compiler setting wins.
        "useLiteralKeys": "off"
      },
      "correctness": {
        // React Hooks deps — no eslint-plugin-react-hooks was configured.
        "useExhaustiveDependencies": "off"
      },
      "security": {
        // dangerouslySetInnerHTML is used deliberately (rendered markdown/QR);
        // ESLint had no equivalent. Kept as a conscious trust-zone residual.
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        // consistent-type-imports was OFF under typescript-eslint here.
        "useImportType": "off",
        // string-concat → template-literal rewrite (134 infos) — cosmetic.
        "useTemplate": "off"
      },
      "suspicious": {
        // Intentional ANSI/terminal control-char regexes (\x1b[...] etc.) — this
        // is a tmux/terminal tool; these regexes are the point.
        "noControlCharactersInRegex": "off",
        // Index-as-key in small static SVG/list renders ESLint never flagged.
        "noArrayIndexKey": "off",
        // Parenthesized assignments in loop/cond heads (ESLint no-cond-assign
        // defaulted to except-parens, which allowed these).
        "noAssignInExpressions": "off",
        // `let x;` (assigned later in try/catch) — TS/ESLint accepted these.
        "noImplicitAnyLet": "off",
        // Deliberate __proto__ access in a prototype-pollution defense test.
        "noProto": "off",
        // ${...} inside plain strings that are intentionally not templates.
        "noTemplateCurlyInString": "off",
        // forEach/map callbacks that intentionally return a value for side use.
        "useIterableCallbackReturn": "off"
      }
    }
  },

  // No import-organizing / assist actions.
  "assist": { "enabled": false }
}
