{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // Environment — Node + Bun, ESM. `nodenext` matches how the daemon actually
    // resolves modules, and keeps esbuild / Node type-stripping / Bun in agreement.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": ["node", "bun"],

    // No emit — execution is by Node type-stripping, Bun, or the esbuild bundle.
    // Explicit `.ts` import extensions (required by Node's stripper) are allowed.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    // Coexistence knob: legacy .mjs are parsed but NOT type-checked. Each module
    // opts into checking when it converts to .ts (F1b — convert per pillar).
    "allowJs": true,
    "checkJs": false,

    // Maximally strict — the whole point of the migration.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noPropertyAccessFromIndexSignature": true,
    "forceConsistentCasingInFileNames": true,
    // The sole runtime is Bun, which strips types (does not downlevel), so non-erasable
    // TS syntax (parameter properties, enums, namespaces) must be a typecheck error. A
    // repo-wide grep confirms none exist today, so this is a guard, not a migration.
    "erasableSyntaxOnly": true,

    // Third-party .d.ts (incl. @types/node × @types/bun overlap) are not our problem.
    "skipLibCheck": true
  },
  "include": ["contracts/**/*", "scripts/**/*", "bin/**/*", "tests/**/*"],
  "exclude": [
    "node_modules",
    "board",
    "scripts/fleetd/fleetd.bundle.mjs",
    "scripts/fleetd/board-dist",
    // These three tests statically import board/src/*.ts (browser modules that
    // reference DOM globals). This program is the DOM-less daemon — pulling those
    // imports in here would surface DOM errors that aren't the daemon's. They are
    // type-checked under tsconfig.board-tests.json (root + DOM lib) instead.
    "tests/board-util.test.ts",
    "tests/board-termdiag.test.ts",
    "tests/board-markdown.test.ts"
  ]
}
