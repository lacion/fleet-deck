{
  "name": "fleetdeck",
  "version": "0.22.4",
  "description": "Fleet Deck — localhost daemon + board that makes every Claude Code session on a machine visible. Tested against Claude Code 2.1.206.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "fleetdeck": "bin/fleetdeck.mjs"
  },
  "files": [
    "bin/",
    "scripts/fleetd/fleetd.bundle.mjs",
    "scripts/fleetd/board-dist/",
    "docs/CODER.md"
  ],
  "author": "Luis Morales <luismmorales@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lacion/fleet-deck.git"
  },
  "bugs": {
    "url": "https://github.com/lacion/fleet-deck/issues"
  },
  "homepage": "https://github.com/lacion/fleet-deck#readme",
  "keywords": [
    "claude-code",
    "claude",
    "plugin",
    "tmux",
    "agents",
    "orchestration",
    "dashboard",
    "fleet"
  ],
  "scripts": {
    "start": "node --no-warnings=ExperimentalWarning scripts/fleetd/fleetd.mjs",
    "test": "node --test --test-concurrency=1 --test-timeout=300000",
    "test:bundle": "FLEETDECK_TEST_DAEMON_SCRIPT=$PWD/scripts/fleetd/fleetd.bundle.mjs node --test --test-concurrency=1 --test-timeout=300000",
    "test:filewise": "node scripts/run-tests-filewise.mjs",
    "test:bundle:filewise": "FLEETDECK_TEST_DAEMON_SCRIPT=$PWD/scripts/fleetd/fleetd.bundle.mjs node scripts/run-tests-filewise.mjs",
    "bundle": "esbuild scripts/fleetd/fleetd.mjs --bundle --platform=node --format=esm --outfile=scripts/fleetd/fleetd.bundle.mjs --external:bufferutil --external:utf-8-validate --external:bun:sqlite --banner:js=\"// GENERATED by 'bun run bundle' — do not edit. Source: scripts/fleetd/*.mjs\nimport { createRequire as __cr } from 'node:module'; const require = __cr(import.meta.url);\"",
    "build:board": "cd board && bun install && bun run build",
    "smoke": "bash demo/run-smoke.sh",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p board/tsconfig.json",
    "lint": "eslint \"**/*.ts\" \"**/*.tsx\" \"**/*.mts\" \"**/*.cts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint \"**/*.ts\" \"**/*.tsx\" \"**/*.mts\" \"**/*.cts\" --fix --no-error-on-unmatched-pattern",
    "format": "prettier --write --no-error-on-unmatched-pattern \"**/*.{ts,tsx,mts,cts}\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"**/*.{ts,tsx,mts,cts}\""
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "22",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0"
  }
}
